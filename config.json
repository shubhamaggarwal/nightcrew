{
  "max_concurrent": 3,
  "poll_interval_seconds": 5,
  "max_fix_cycles": 2,
  "port": 8377,
  "states": {
    "requirements": {
      "model": "claude-opus-5",
      "prompt": "prompts/requirements.md",
      "max_turns": 25,
      "timeout_minutes": 10,
      "allowed_tools": "Read,Grep,Glob,Write"
    },
    "planning": {
      "model": "claude-opus-5",
      "prompt": "prompts/planning.md",
      "max_turns": 30,
      "timeout_minutes": 15,
      "allowed_tools": "Read,Grep,Glob,Write"
    },
    "executing": {
      "model": "claude-sonnet-5",
      "prompt": "prompts/executing.md",
      "max_turns": 80,
      "timeout_minutes": 45,
      "allowed_tools": "Read,Grep,Glob,Write,Edit,Bash"
    },
    "verifying": {
      "model": "claude-sonnet-5",
      "prompt": "prompts/verifying.md",
      "max_turns": 30,
      "timeout_minutes": 20,
      "allowed_tools": "Read,Grep,Glob,Bash,Write"
    }
  }
}
