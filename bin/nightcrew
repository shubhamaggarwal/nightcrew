#!/usr/bin/env bash
# Nightcrew CLI: start, stop, or inspect the poller + dashboard.
# Safe to symlink onto PATH; resolves its real location to find the repo.
set -uo pipefail

self=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")
root=$(cd "$(dirname "$self")/.." && pwd)

port() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("port", 8377))' \
    "$root/config.json"
}

dash_pid() { lsof -nP -tiTCP:"$(port)" -sTCP:LISTEN 2>/dev/null || true; }

poller_pid() {
  local pid
  pid=$(cat "$root/state/poller.lock/pid" 2>/dev/null || echo "")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid"
  fi
}

cmd_start() {
  mkdir -p "$root/state"
  local p
  p=$(port)
  if [ -n "$(dash_pid)" ]; then
    echo "dashboard: already running on port $p"
  else
    nohup python3 "$root/dashboard/server.py" >> "$root/state/dashboard.log" 2>&1 &
    echo "dashboard: started (pid $!, port $p)"
  fi
  if [ -n "$(poller_pid)" ]; then
    echo "poller: already running (pid $(poller_pid))"
  else
    nohup "$root/bin/poller.sh" >> "$root/state/poller.log" 2>&1 &
    echo "poller: started (pid $!)"
  fi
  sleep 1
  open "http://127.0.0.1:$p" 2>/dev/null || true
}

cmd_stop() {
  local pid
  pid=$(poller_pid)
  if [ -n "$pid" ]; then
    kill "$pid" && echo "poller: stopped (pid $pid)"
  else
    echo "poller: not running"
  fi
  rm -rf "$root/state/poller.lock"
  pid=$(dash_pid)
  if [ -n "$pid" ]; then
    kill $pid && echo "dashboard: stopped (pid $pid)"
  else
    echo "dashboard: not running"
  fi
}

cmd_status() {
  local p
  p=$(port)
  if [ -n "$(dash_pid)" ]; then
    echo "dashboard: running (pid $(dash_pid)) - http://127.0.0.1:$p"
  else
    echo "dashboard: stopped"
  fi
  if [ -n "$(poller_pid)" ]; then
    echo "poller: running (pid $(poller_pid))"
  else
    echo "poller: stopped"
  fi
}

cmd_install_launchd() {
  local dst="$HOME/Library/LaunchAgents" f out
  mkdir -p "$root/state" "$dst"
  for f in "$root"/launchd/*.plist.template; do
    out="$dst/$(basename "${f%.template}")"
    sed "s|__NC_ROOT__|$root|g" "$f" > "$out"
    echo "wrote $out"
  done
  echo "load them with:"
  echo "  launchctl load $dst/com.nightcrew.poller.plist"
  echo "  launchctl load $dst/com.nightcrew.dashboard.plist"
  echo "(use 'nightcrew stop' first if the foreground processes are running)"
}

case "${1:-}" in
  start)           cmd_start ;;
  stop)            cmd_stop ;;
  status)          cmd_status ;;
  install-launchd) cmd_install_launchd ;;
  *)
    echo "usage: nightcrew start|stop|status|install-launchd"
    exit 2
    ;;
esac
