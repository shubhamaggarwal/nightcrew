<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nightcrew.poller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__NC_ROOT__/bin/poller.sh</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__NC_ROOT__/state/poller.log</string>
  <key>StandardErrorPath</key><string>__NC_ROOT__/state/poller.log</string>
</dict>
</plist>
